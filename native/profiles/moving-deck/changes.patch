+void VesselActor::ValidateThrusterForces(std::vector<float>& forces) {
+    // 确保推进器数量匹配
+    if (forces.size() != thrusters_.size()) {
+        forces.resize(thrusters_.size(), 0.0f);
+    }
+    
+    // 限制推进器力在允许范围内
+    for (size_t i = 0; i < forces.size(); ++i) {
+        forces[i] = std::clamp(
+            forces[i],
+            -thrusters_[i].max_force,
+            thrusters_[i].max_force
+        );
+    }
+}
