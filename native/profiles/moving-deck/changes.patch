+#ifndef CORE_SIM_INCLUDE_CORE_SIM_ACTOR_VESSEL_ACTOR_HPP_
+#define CORE_SIM_INCLUDE_CORE_SIM_ACTOR_VESSEL_ACTOR_HPP_
+
+#include <memory>
+#include <vector>
+#include <unordered_map>
+#include <string>
+
+#include "core_sim/actor.hpp"
