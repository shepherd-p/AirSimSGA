+void AUnrealRobot::RefreshSupportContact() {
+  if (!bSupportTracking || !RobotRootLink) return;
+  auto Info = LastSupportInfo;
+  Info.time_stamp = projectairsim::SimClock::Get()->NowSimNanos();
+  Info.has_collided = false;
+  Info.support_valid = false;
+  const FVector Root = RobotRootLink->GetComponentLocation();
+  const FVector Foot = Root - FVector(0,0,SupportRootHeightCm);
+  auto Comp = SupportComponent.Get();
+  if (IsValid(Comp) && Comp->IsCollisionEnabled()) {
+    FHitResult Probe;
+    FCollisionQueryParams Params(SCENE_QUERY_STAT(MovingDeckSupport), false);
+    // A short, real geometry query under the body: no support across an edge,
+    // after deletion/disablement, or after taking off. No actor pose following.
+    if (Comp->LineTraceComponent(Probe, Foot+FVector(0,0,8),
+                                Foot-FVector(0,0,3), Params) &&
+        Probe.ImpactNormal.Z > .95) {
+      Info.normal = projectairsim::Vector3(Probe.ImpactNormal.X,Probe.ImpactNormal.Y,-Probe.ImpactNormal.Z);
+      Info.impact_point = projectairsim::Vector3(Probe.ImpactPoint.X*.01,Probe.ImpactPoint.Y*.01,-Probe.ImpactPoint.Z*.01);
+      Info.position = projectairsim::Vector3(Root.X*.01,Root.Y*.01,-Root.Z*.01);
+      Info.support_gap = float(FVector::DotProduct(Foot-Probe.ImpactPoint,Probe.ImpactNormal))*.01f;
+      Info.support_valid = true;
+      Info.has_collided = true;
+      Info.penetration_depth = FMath::Max(0.f,-Info.support_gap);
+      FillContactMotion(Info, Comp);
+    }
+  }
+  LastSupportInfo = Info;
+  SimRobot.UpdateCollisionInfo(Info);
 }
 
