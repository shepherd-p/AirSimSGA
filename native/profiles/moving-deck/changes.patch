+void AUnrealRobot::FillContactMotion(projectairsim::CollisionInfo& Info,
+                                     UPrimitiveComponent* OtherComp) {
+  Info.component_name = TCHAR_TO_UTF8(*OtherComp->GetName());
+  if (auto Link = Cast<UUnrealRobotLink>(OtherComp))
+    Info.support_friction = Link->GetLinkFriction();
+  if (auto OtherRobot = Cast<AUnrealRobot>(OtherComp->GetOwner())) {
+    FScopeLock Lock(&OtherRobot->UpdateMutex);
+    const auto& Kin = OtherRobot->RobotKinematics;
+    Info.other_pose = Kin.pose;
+    Info.other_linear_velocity = Kin.twist.linear;
+    Info.other_angular_velocity = Kin.pose.orientation * Kin.twist.angular;
+    Info.contact_velocity = Info.other_linear_velocity +
+        Info.other_angular_velocity.cross(Info.impact_point - Kin.pose.position);
+  } else {
+    const FVector Loc = OtherComp->GetComponentLocation();
+    Info.other_pose.position = projectairsim::Vector3(Loc.X*.01,Loc.Y*.01,-Loc.Z*.01);
+    Info.other_pose.orientation = projectairsim::Quaternion::Identity();
+    FVector V = OtherComp->GetComponentVelocity();
+    FVector W = FVector::ZeroVector;
+    if (OtherComp->IsSimulatingPhysics()) {
+      V = OtherComp->GetPhysicsLinearVelocityAtPoint(
+          FVector(Info.impact_point.x()*100,Info.impact_point.y()*100,-Info.impact_point.z()*100));
+      W = OtherComp->GetPhysicsAngularVelocityInRadians();
+    }
+    Info.contact_velocity = projectairsim::Vector3(V.X*.01,V.Y*.01,-V.Z*.01);
+    Info.other_linear_velocity = Info.contact_velocity;
+    Info.other_angular_velocity = projectairsim::Vector3(-W.X,-W.Y,W.Z);
+  }
+}
