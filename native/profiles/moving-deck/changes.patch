+  auto kin = robot.GetKinematics();
+  kin.twist.linear = {0.5f, 0, 0};
+  robot.UpdateKinematics(kin);
+  const auto start = kin.pose.position;
+  projectairsim::CollisionInfo c;
+  c.support_managed = c.support_valid = true;
+  c.normal = {0,0,-1};
+  c.contact_velocity = {0.5f,0,0};
+  c.support_friction = .5f;
+  for (int i=0; i<600; ++i) {
+    c.position = robot.GetKinematics().pose.position;
+    c.time_stamp = projectairsim::SimClock::Get()->NowSimNanos();
+    robot.UpdateCollisionInfo(c);
+    model.StepPhysicsBody(5000000, body);
+  }
+  auto carried = robot.GetKinematics();
+  EXPECT_NEAR(carried.pose.position.x()-start.x(), 1.5f, .001f);
+  EXPECT_NEAR(carried.pose.position.z(), start.z(), .001f);
+  // Remove support through the exact production collision snapshot path.
+  c.support_valid = false;
+  robot.UpdateCollisionInfo(c);
+  for (int i=0;i<20;++i) model.StepPhysicsBody(5000000,body);
+  EXPECT_GT(robot.GetKinematics().pose.position.z(), carried.pose.position.z()+.01f);
+  EXPECT_GT(robot.GetKinematics().twist.linear.x(), .4f);
+}
