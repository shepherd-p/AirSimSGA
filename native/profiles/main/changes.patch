+void Scene::Impl::RegisterVesselServiceMethods(const std::string& vessel_id) {
+  // Actors are loaded after scene-level methods. Register each vessel here,
+  // once its ID is known, so clients can call it after World loads the scene.
+  if (!vessel_service_ids_.insert(vessel_id).second) return;
+
+  const auto base = topic_path_ + "/robots/" + vessel_id;
+  auto set_thruster_forces =
+      ServiceMethod(base + "/SetThrusterForces", {"forces"});
+  auto set_thruster_forces_handler = set_thruster_forces.CreateMethodHandler(
+      std::function<bool(std::vector<float>)>(
+          [this, vessel_id](std::vector<float> forces) {
+            return SetVesselThrusterForcesById(vessel_id, forces);
+          }));
+  service_manager_.RegisterMethod(set_thruster_forces,
+                                  set_thruster_forces_handler);
+
+  auto set_thruster_azimuths =
+      ServiceMethod(base + "/SetThrusterAzimuths", {"azimuths"});
+  auto set_thruster_azimuths_handler = set_thruster_azimuths.CreateMethodHandler(
+      std::function<bool(std::vector<float>)>(
+          [this, vessel_id](std::vector<float> azimuths) {
+            return SetVesselThrusterAzimuthsById(vessel_id, azimuths);
+          }));
+  service_manager_.RegisterMethod(set_thruster_azimuths,
+                                  set_thruster_azimuths_handler);
+}
+
+void Scene::Impl::RegisterVesselServiceMethods() {
+  // Vessel actors are loaded before Start(). Register their per-actor
+  // services after the scene-level service table has been initialized.
+  for (const auto& vessel_id : vessel_robot_ids_) {
+    RegisterVesselServiceMethods(vessel_id);
+  }
+}
