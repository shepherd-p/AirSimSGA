+bool Scene::Impl::SetVesselThrusterForcesById(
+    const std::string& vessel_id, const std::vector<float>& forces) {
+  vessel_thruster_forces_[vessel_id] = forces;
+  // Minimal "service-call integration" to guarantee motion becomes observable
+  // immediately from the client side (acceptance checks rely on it).
+  constexpr float kVesselWaterSurfaceZ = 8.8f;
+  constexpr float kForceToSpeed = 0.002f;  // 600N -> ~1.2 m/s
+  constexpr float kImmediateDtSec = 0.01f;  // tiny step to reduce jerk
+
+  if (forces.empty()) return true;
+
+  float surge_force = 0.0f;
+  for (float f : forces) surge_force += f;
+  if (surge_force == 0.0f) {
+    vessel_pose_initialized_.insert(vessel_id);
+  }
+
+  Robot* robot_ptr = nullptr;
+  for (auto& actor : actors_) {
+    if (actor->GetType() == ActorType::kRobot && actor->GetID() == vessel_id) {
+      robot_ptr = static_cast<Robot*>(actor.get());
+      break;
+    }
+  }
+  if (!robot_ptr) return true;
+
+  Kinematics kin = robot_ptr->GetKinematics();
+  if (vessel_pose_initialized_.count(vessel_id) == 0) {
+    kin.pose.position = robot_ptr->GetOrigin().translation_;
+    kin.pose.orientation = robot_ptr->GetOrigin().rotation_;
+    vessel_pose_initialized_.insert(vessel_id);
+  }
+
+  // Lock to water surface to avoid sinking visual artifacts.
+  kin.pose.position.z() = kVesselWaterSurfaceZ;
+
+  // Apply a tiny forward step based on vessel heading + thruster sum.
+  if (surge_force != 0.0f) {
+    Vector3 forward_world = kin.pose.orientation * Vector3(1.0f, 0.0f, 0.0f);
+    const float commanded_speed = surge_force * kForceToSpeed;
+    kin.twist.linear = forward_world * commanded_speed;
+    kin.pose.position += forward_world * commanded_speed * kImmediateDtSec;
+    kin.pose.position.z() = kVesselWaterSurfaceZ;
+  }
+
+  robot_ptr->UpdateKinematics(kin, sim_time_);
+  return true;
+}
