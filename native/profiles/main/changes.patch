+void Scene::Impl::ApplyVesselThrustersToRobot(Robot& robot, TimeNano sim_dt_nanos) {
+  constexpr float kVesselWaterSurfaceZ = 8.8f;
+  constexpr float kForceToSpeed = 0.002f;  // 600N -> ~1.2 m/s
+
+  Kinematics kin = robot.GetKinematics();
+  if (vessel_pose_initialized_.count(robot.GetID()) == 0) {
+    const auto& origin = robot.GetOrigin();
+    kin.pose.position = origin.translation_;
+    kin.pose.orientation = origin.rotation_;
+    kin.pose.position.z() = kVesselWaterSurfaceZ;
+    kin.twist = Twist::Zero();
+    kin.accels = Accelerations::Zero();
+    robot.UpdateKinematics(kin, sim_time_);
+    vessel_pose_initialized_.insert(robot.GetID());
+  }
+
+  const auto it = vessel_thruster_forces_.find(robot.GetID());
+  if (it == vessel_thruster_forces_.end()) {
+    return;
+  }
+
+  const auto& forces = it->second;
+  if (forces.empty()) {
+    return;
+  }
+
+  float surge_force = 0.0f;
+  for (float f : forces) {
+    surge_force += f;
+  }
+
+  const float dt = SimClock::Get()->NanosToSec(sim_dt_nanos);
+  if (dt <= 0.0f) {
+    return;
+  }
+
+  // Move along vessel heading in world frame.
+  Vector3 forward_world = kin.pose.orientation * Vector3(1.0f, 0.0f, 0.0f);
+  const float commanded_speed = surge_force * kForceToSpeed;
+  kin.twist.linear = forward_world * commanded_speed;
+  kin.pose.position += kin.twist.linear * dt;
+  kin.pose.position.z() = kVesselWaterSurfaceZ;
+  robot.UpdateKinematics(kin, sim_time_);
 }
 
